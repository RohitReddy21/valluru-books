NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
API_BASE_URL=http://127.0.0.1:4000

# Shared with the backend. An admin save POSTs this to /api/revalidate, which drops the
# cached site content instead of waiting out the 300s ISR window. Must match the backend
# value exactly, or the route answers 401. Unset here, the route answers 503.
REVALIDATE_SECRET=replace-with-a-long-random-string
