PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3010,http://localhost:3010,http://localhost:3000
# Optional: also accept this project's Vercel preview builds (they get a new address each deploy).
# Anchored regex; keep it as narrow as your own project's addresses.
# PREVIEW_ORIGIN_PATTERN=^https://valluru-books-[a-z0-9-]+-rohitreddy21s-projects.vercel.app$
PUBLIC_SITE_URL=https://www.thevalluru.org
ADMIN_NOTIFICATION_EMAIL=owner-inbox@example.com
REPLY_TO_EMAIL=owner-inbox@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Signs subscriber cookies and booklet access tokens — this is what makes the booklet
# gate real. Unset, it silently falls back to ADMIN_PASSWORD and then to a hardcoded
# string, and anyone who guesses that value can mint their own access token. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing subscriber cookie and access token.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
MAX_UPLOAD_BYTES=629145600

# Sandbox uses its own database and its own Supabase project. Never point a sandbox at
# production data: MONGODB_DB=valluru_sandbox, and a separate Supabase URL and key.
MONGODB_DB=valluru_books
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=valluru
RESEND_API_KEY=re_your_real_resend_api_key
RESEND_FROM="The Valluru <hello@thevalluru.org>"
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://your-project.supabase.co
# Name of a PRIVATE Supabase bucket holding the booklet PDFs (same paths as books/pdfs). Unset
# means they are read from the public books bucket, as before. Procedure: docs/supabase-private-pdf-bucket.md
PRIVATE_PDF_BUCKET=

# Shared with the frontend, and must match its value exactly. After a successful admin
# content save the backend POSTs this to the frontend's /api/revalidate so the change is
# visible immediately rather than after the 300s ISR window. Leave it unset to skip the
# ping entirely — saves still succeed, they just wait for the window.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Where that ping goes. Defaults to PUBLIC_SITE_URL; set it when the frontend lives
# somewhere else, such as a Vercel preview deployment or a local dev server.
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3010
