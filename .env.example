PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3010,http://localhost:3010,http://localhost:3000
PUBLIC_SITE_URL=https://www.thevalluru.org
ADMIN_NOTIFICATION_EMAIL=owner-inbox@example.com
REPLY_TO_EMAIL=owner-inbox@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Signs subscriber cookies and booklet access tokens — this is what makes the booklet
# gate real. Unset, it falls back to ADMIN_PASSWORD and then to a hardcoded string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
MAX_UPLOAD_BYTES=629145600

# Sandbox uses its own database and its own Supabase project. Never point a sandbox at
# production data: MONGODB_DB=valluru_sandbox, and a separate Supabase URL and key.
MONGODB_DB=valluru_books
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=valluru
RESEND_API_KEY=re_your_real_resend_api_key
RESEND_FROM="The Valluru <hello@thevalluru.org>"
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://your-project.supabase.co

# Cache busting on admin publish. The same value must be set for both the backend and the
# frontend (frontend/.env.local); a mismatch makes /api/revalidate answer 401, and leaving
# it unset on the frontend makes it answer 503.
REVALIDATE_SECRET=replace-with-a-long-random-string
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3010

# Frontend only — where the browser and the server components reach the API.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
